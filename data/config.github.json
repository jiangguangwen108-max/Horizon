{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["zh", "en"],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": { "threshold": 6.5, "topic_dedup": true },
      "tech-blog": { "threshold": 4.0, "topic_dedup": false },
      "finance-news": { "threshold": 7.0, "topic_dedup": true }
    }
  },
  "sources": {
    "github": [
      { "type": "repo_releases", "owner": "vllm-project", "repo": "vllm", "enabled": true, "profile": "tech-news" },
      { "type": "repo_releases", "owner": "sgl-project", "repo": "sglang", "enabled": true, "profile": "tech-news" },
      { "type": "user_events", "username": "karpathy", "enabled": true, "profile": "tech-news" }
    ],
    "hackernews": { "enabled": true, "fetch_top_stories": 30, "min_score": 120, "profile": "tech-news" },
    "rss": [
      { "name": "Simon Willison", "url": "https://simonwillison.net/atom/everything/", "enabled": true, "category": "ai-tools", "profile": "tech-news" },
      { "name": "GitHub Trending - Daily", "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml", "enabled": true, "category": "github-trending", "profile": "tech-news" },
      { "name": "机器之心", "url": "https://www.jiqizhixin.com/rss", "enabled": true, "category": "ai-news-zh", "profile": "tech-news" },
      { "name": "少数派", "url": "https://sspai.com/feed", "enabled": true, "category": "tech-zh", "profile": "tech-news" }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        { "subreddit": "MachineLearning", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 60, "profile": "tech-news" },
        { "subreddit": "LocalLLaMA", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 60, "profile": "tech-news" }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": true,
      "channels": [
        { "channel": "zaihuapd", "enabled": true, "fetch_limit": 20, "profile": ["tech-news", "finance-news"] }
      ]
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["All"],
      "keywords": ["llm", "agent", "ai"],
      "min_stars": 10,
      "max_items": 20,
      "profile": "tech-news"
    }
  },
  "collection": { "time_window_hours": 24 },
  "digest": {
    "max_items": 20,
    "profile_order": ["tech-news", "tech-blog", "finance-news"],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "email": {
    "enabled": false,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "placeholder@qq.com",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": null,
    "headers": ""
  },
  "wechat": { "enabled": false, "languages": null, "chunk_size": 4000 }
}